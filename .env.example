# Скопируйте в .env и заполните реальными значениями. Настоящие секреты — только env сервера.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid
# Для docker compose (T34) — postgres; локальная разработка без compose может оставить sqlite3.
DJANGO_DB_ENGINE=django.db.backends.postgresql
# Учётные данные Postgres (используются и контейнером db, и web через compose).
POSTGRES_DB=decanat
POSTGRES_USER=decanat
POSTGRES_PASSWORD=CHANGE_ME
# Для sqlite-разработки — путь к файлу; при postgres не используется (имя БД — POSTGRES_DB).
# DJANGO_DB_NAME=
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432
# Адрес сайта для Caddy (реальный домен в проде; localhost — для локальной проверки).
SITE_ADDRESS=localhost
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_SESSION_COOKIE_SECURE=True
# В docker compose сайт всегда за собственным прокси Caddy с TLS — оставлять True.
DJANGO_TRUST_PROXY_SSL=True
# Пароли демо-аккаунтов для seed (не хранить в Git; если не заданы, seed генерирует
# случайные и пишет их один раз в gitignored .secrets/demo_passwords.txt)
DEMO_STUDENT_A_PASSWORD=
DEMO_STUDENT_B_PASSWORD=
DEMO_STAFF_PASSWORD=
