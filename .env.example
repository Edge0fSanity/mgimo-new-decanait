# Скопируйте в .env и заполните реальными значениями. Настоящие секреты — только env сервера.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_SESSION_COOKIE_SECURE=True
# Пароли демо-аккаунтов для seed (не хранить в Git; если не заданы, seed генерирует
# случайные и пишет их один раз в gitignored .secrets/demo_passwords.txt)
DEMO_STUDENT_A_PASSWORD=
DEMO_STUDENT_B_PASSWORD=
